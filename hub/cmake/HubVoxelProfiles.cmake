# Compiles hub/voxel-profiles/*.voxel into a source file defining
# hub::voxel_profiles::builtin_profiles(). Editing a profile reconfigures.
function(hub_generate_voxel_profiles out_file)
    set(profile_dir "${PROJECT_SOURCE_DIR}/hub/voxel-profiles")
    file(GLOB profiles CONFIGURE_DEPENDS "${profile_dir}/*.voxel")
    list(SORT profiles)
    set(entries "")
    foreach(profile IN LISTS profiles)
        get_filename_component(name "${profile}" NAME)
        file(READ "${profile}" text)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${profile}")
        string(APPEND entries "        {\"${name}\", R\"hubvoxel(${text})hubvoxel\"},\n")
    endforeach()
    file(CONFIGURE OUTPUT "${out_file}" @ONLY CONTENT
"// Generated by hub/cmake/HubVoxelProfiles.cmake from hub/voxel-profiles. Do not edit.
#include \"hub_voxel_profiles.h\"

namespace hub::voxel_profiles {

const std::vector<BuiltinProfile>& builtin_profiles() {
    static const std::vector<BuiltinProfile> profiles = {
@entries@    };
    return profiles;
}

}  // namespace hub::voxel_profiles
")
endfunction()
